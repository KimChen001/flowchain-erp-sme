# Copy to deploy/env.production, keep that file outside version control, and
# replace every placeholder. Prefer an immutable image digest in releases.
FLOWCHAIN_IMAGE=registry.example.invalid/flowchain@sha256:replace-with-image-digest
FLOWCHAIN_HTTP_PORT=8787

DATABASE_URL=postgresql://replace-user:replace-password@postgres.example.invalid:5432/flowchain?schema=public
FLOWCHAIN_PERSISTENCE_MODE=database
FLOWCHAIN_DEFAULT_TENANT_ID=replace-with-provisioned-tenant-id
FLOWCHAIN_LOCAL_SESSION_SECRET=replace-with-at-least-32-random-characters
FLOWCHAIN_ATTACHMENT_STORAGE_PROVIDER=local
FLOWCHAIN_UPLOAD_STORAGE_DIR=/var/lib/flowchain/uploads
FLOWCHAIN_COMMIT_SHA=replace-with-image-commit-sha
FLOWCHAIN_BRANCH=replace-with-release-branch
FLOWCHAIN_ALLOW_LOCAL_ACTOR_BOOTSTRAP=false
# JSON access log on stdout, one line per API request; set to off to disable.
FLOWCHAIN_REQUEST_LOG=on

# US trial capability set. These five switches are what a paid US trial
# needs: receiving posting and reversal, sales order lifecycle and outbound
# shipment posting, stock transfer / cycle count / adjustment documents,
# operational finance (supplier invoices, three-way match, payables, customer
# invoices, receivables and aging), and mobile operations (tasks, PO approval
# and receiving; in database mode the only path that approves a PO or creates
# a receipt). Operational finance does not execute payments, collections, tax
# filing or general-ledger postings.
FLOWCHAIN_ENABLE_DB_RECEIVING_POSTING=true
FLOWCHAIN_ENABLE_DB_OUTBOUND_POSTING=true
FLOWCHAIN_ENABLE_DB_INVENTORY_OPERATIONS=true
FLOWCHAIN_ENABLE_DB_OPERATIONAL_FINANCE=true
FLOWCHAIN_ENABLE_DB_MOBILE_OPERATIONS=true

# Every other capability remains off unless the release has explicitly
# approved it: returns and quarantine, internal settlement, settlement
# workflow, bank reconciliation, Mobile Sync and Universal Intake.
FLOWCHAIN_ENABLE_DB_MOBILE_SYNC=false
# When Mobile Sync is enabled, configure both values with a secret of at least
# 32 characters. Do not commit the populated file.
# FLOWCHAIN_SYNC_CURSOR_CURRENT_KEY_ID=replace-with-key-id
# FLOWCHAIN_SYNC_CURSOR_CURRENT_SECRET=replace-with-at-least-32-random-characters
