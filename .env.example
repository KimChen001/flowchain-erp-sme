# PostgreSQL is the only authoritative runtime. Use deploy/env.production.example
# for the complete production contract; this file is a non-secret local template.
NODE_ENV=development
FLOWCHAIN_PERSISTENCE_MODE=database
DATABASE_URL=postgresql://user:replace-me@127.0.0.1:5432/flowchain
FLOWCHAIN_DEFAULT_TENANT_ID=tenant-flowchain-local
FLOWCHAIN_LOCAL_SESSION_SECRET=replace-with-at-least-32-random-characters
FLOWCHAIN_ALLOW_LOCAL_ACTOR_BOOTSTRAP=false
# Formal receiving post/reverse remains off unless database mode is active too.
FLOWCHAIN_ENABLE_DB_RECEIVING_POSTING=false
# Bank statement reconciliation is PostgreSQL-only and explicitly enabled.
FLOWCHAIN_ENABLE_DB_BANK_RECONCILIATION=false
FLOWCHAIN_BANK_IMPORT_MAX_FILE_BYTES=20971520
FLOWCHAIN_BANK_IMPORT_MAX_ROWS=10000
FLOWCHAIN_BANK_IMPORT_MAX_SHEETS=3
# DATABASE_URL_TEST=postgresql://user:password@localhost:5432/flowchain_test

# Optional AI providers remain disabled unless explicitly configured.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5-mini
OPENAI_PROXY_URL=http://127.0.0.1:15236

# Optional: use Doubao / Volcengine Ark instead of OpenAI
AI_PROVIDER=doubao
ARK_API_KEY=your-ark-api-key-here
ARK_MODEL=doubao-seed-2-0-lite-260215
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
