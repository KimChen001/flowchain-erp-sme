# PostgreSQL is the only authoritative runtime. Use deploy/env.production.example
# for the complete production contract; this file is a non-secret local template.
NODE_ENV=development
FLOWCHAIN_PERSISTENCE_MODE=database
DATABASE_URL=postgresql://user:replace-me@127.0.0.1:5432/flowchain
FLOWCHAIN_DEFAULT_TENANT_ID=tenant-flowchain-local
FLOWCHAIN_LOCAL_SESSION_SECRET=replace-with-at-least-32-random-characters
FLOWCHAIN_ALLOW_LOCAL_ACTOR_BOOTSTRAP=false
# One JSON access-log line per API request (method, path, status, duration, ids). Set to off to disable.
FLOWCHAIN_REQUEST_LOG=on
# Email sign-in links. Outside production the default provider is outbox: each
# message is written to a JSON file in the OS temp directory (or to
# FLOWCHAIN_MAIL_OUTBOX_PATH) instead of being sent. Production requires
# postmark or resend; see deploy/env.production.example and deploy/README.md.
FLOWCHAIN_MAIL_PROVIDER=outbox
# FLOWCHAIN_MAIL_OUTBOX_PATH=
# Origin for sign-in links. Without it, local links use the browser's
# loopback origin.
# FLOWCHAIN_PUBLIC_BASE_URL=http://127.0.0.1:5173
# US trial capability set. These five switches are what a paid US trial
# needs: receiving posting and reversal, sales order lifecycle and outbound
# shipment posting, stock transfer / cycle count / adjustment documents,
# operational finance (supplier invoices, three-way match, payables, customer
# invoices, receivables and aging), and mobile operations (tasks, PO approval
# and receiving; in database mode the only path that approves a PO or creates
# a receipt). Operational finance does not execute payments, collections, tax
# filing or general-ledger postings.
FLOWCHAIN_ENABLE_DB_RECEIVING_POSTING=true
FLOWCHAIN_ENABLE_DB_OUTBOUND_POSTING=true
FLOWCHAIN_ENABLE_DB_INVENTORY_OPERATIONS=true
FLOWCHAIN_ENABLE_DB_OPERATIONAL_FINANCE=true
FLOWCHAIN_ENABLE_DB_MOBILE_OPERATIONS=true
# CSV import of items, suppliers, customers, item suppliers and opening stock
# through the manual-entry commands. Opening stock becomes draft adjustments
# that a person readies and posts.
FLOWCHAIN_ENABLE_DATA_IMPORT=true
# Upload limits for the import (bytes of one file, data rows of one file).
FLOWCHAIN_DATA_IMPORT_MAX_FILE_BYTES=2097152
FLOWCHAIN_DATA_IMPORT_MAX_ROWS=2000
# Capabilities outside the US trial set stay off. All of them also require
# database persistence mode.
# Bank statement reconciliation is PostgreSQL-only and explicitly enabled.
FLOWCHAIN_ENABLE_DB_BANK_RECONCILIATION=false
FLOWCHAIN_BANK_IMPORT_MAX_FILE_BYTES=20971520
FLOWCHAIN_BANK_IMPORT_MAX_ROWS=10000
FLOWCHAIN_BANK_IMPORT_MAX_SHEETS=3
# DATABASE_URL_TEST=postgresql://user:password@localhost:5432/flowchain_test

# The assistant answers from workspace data and calls no model. A model
# provider stays off until it is configured explicitly; OpenAI
# (FLOWCHAIN_AI_PROVIDER_KIND=openai_responses) is planned for a later release.
# Never put a real key in an example file.
FLOWCHAIN_AI_RUNTIME_MODE=local
FLOWCHAIN_AI_PROVIDER_KIND=disabled
# FLOWCHAIN_AI_PROVIDER_ENDPOINT=
# FLOWCHAIN_AI_PROVIDER_MODEL=
# FLOWCHAIN_AI_PROVIDER_API_KEY=

# Rollback only: serve the retired template gateway and /api/ai/chat again.
FLOWCHAIN_AI_LEGACY_TEMPLATE_GATEWAY=false
# The retired /api/ai/chat route reads these only while the rollback flag is on.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_PROXY_URL=
