# Copy to .env.local and replace LOCAL_PASSWORD with the password for this
# worktree's local PostgreSQL instance. Never commit the resulting file.
NODE_ENV=development
DATABASE_URL=postgresql://flowchain:LOCAL_PASSWORD@127.0.0.1:5432/flowchain_54b1
FLOWCHAIN_DEFAULT_TENANT_ID=tenant-flowchain-local
FLOWCHAIN_PILOT_WORKSPACE_NAME=FlowChain Local Workspace
FLOWCHAIN_DEV_LOCAL=true
SCM_API_PORT=8787
VITE_API_ORIGIN=http://127.0.0.1:8787
FLOWCHAIN_ARTIFACT_STORAGE_ROOT=.local/artifacts
