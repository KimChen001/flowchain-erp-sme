# Copy to .env.local and replace LOCAL_PASSWORD with the password for this
# worktree's local PostgreSQL instance. Never commit the resulting file.
NODE_ENV=development
DATABASE_URL=postgresql://flowchain:LOCAL_PASSWORD@127.0.0.1:5432/flowchain_54b1
FLOWCHAIN_DEFAULT_TENANT_ID=tenant-flowchain-local
FLOWCHAIN_PILOT_WORKSPACE_NAME=FlowChain Local Workspace
FLOWCHAIN_DEV_LOCAL=true
SCM_API_PORT=8787
VITE_API_ORIGIN=http://127.0.0.1:8787
FLOWCHAIN_ARTIFACT_STORAGE_ROOT=.local/artifacts

# Optional: enable OpenAI only for product/company knowledge.
# Keep credentials server-side; never prefix them with VITE_.
# Alternatively, put these values in the ignored .local/openai.env file.
# FLOWCHAIN_KNOWLEDGE_PROVIDER=openai
# OPENAI_API_KEY=
# FLOWCHAIN_KNOWLEDGE_MODEL=gpt-4.1-mini
# FLOWCHAIN_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# FLOWCHAIN_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536

# Alternative Qwen preset. Use .local/ai-provider.env for local development.
# Regional key and Workspace ID must belong to the same Model Studio region.
# FLOWCHAIN_KNOWLEDGE_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# FLOWCHAIN_QWEN_REGION=ap-southeast-1
# FLOWCHAIN_QWEN_WORKSPACE_ID=
# FLOWCHAIN_QWEN_MODEL=qwen-flash
# FLOWCHAIN_QWEN_EMBEDDING_MODEL=text-embedding-v4
# FLOWCHAIN_QWEN_EMBEDDING_DIMENSIONS=1024
